# Required. Any non-empty value works for the local serve process.
OPENAI_API_KEY=

# Leave unset to call the official OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default hosted model. The CLI stays a generic OpenAI-compatible client.
OPENAI_MODEL=gpt-4o-mini

# Local terminal-shell-mini (see README "End-to-end"):
# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_MODEL=terminal-shell-mini
